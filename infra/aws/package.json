{
  "name": "@hollowmere/aws-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run list && npm run synth",
    "list": "npx --no-install cdk list",
    "synth": "npx --no-install cdk synth --strict",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "2.262.2",
    "constructs": "10.8.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "aws-cdk": "2.1134.0",
    "cdk-nag": "3.0.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
