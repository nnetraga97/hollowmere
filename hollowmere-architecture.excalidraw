    {"id":"aws","type":"rectangle","x":60,"y":650,"width":770,"height":245,"angle":0,"strokeColor":"#b45309","backgroundColor":"#fff7ed","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"i0","roundness":{"type":3},"seed":80,"version":1,"versionNonce":80,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"awsText","type":"text","x":84,"y":672,"width":722,"height":196,"angle":0,"strokeColor":"#78350f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"i1","roundness":null,"seed":81,"version":1,"versionNonce":81,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"CURRENT AWS CDK v2 STACK\n\nVPC (2 AZs) · ALB · ECS Cluster · Fargate web service\nFargate scheduler service · one-off migration task\nECR: hollowmere-web + hollowmere-scheduler\nSecrets Manager · IAM task roles · CloudWatch Logs + alarms\nGitHub Actions → OIDC → ECR push → ECS rollout\nAmazon Bedrock permissions are scoped to reasoning + embedding models","fontSize":17,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":"aws","originalText":"CURRENT AWS CDK v2 STACK\n\nVPC (2 AZs) · ALB · ECS Cluster · Fargate web service\nFargate scheduler service · one-off migration task\nECR: hollowmere-web + hollowmere-scheduler\nSecrets Manager · IAM task roles · CloudWatch Logs + alarms\nGitHub Actions → OIDC → ECR push → ECS rollout\nAmazon Bedrock permissions are scoped to reasoning + embedding models","autoResize":true,"lineHeight":1.25},
    {"id":"k8s","type":"rectangle","x":880,"y":650,"width":730,"height":245,"angle":0,"strokeColor":"#0e7490","backgroundColor":"#ecfeff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"j0","roundness":{"type":3},"seed":90,"version":1,"versionNonce":90,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"k8sText","type":"text","x":904,"y":672,"width":682,"height":196,"angle":0,"strokeColor":"#164e63","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"j1","roundness":null,"seed":91,"version":1,"versionNonce":91,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"PROPOSED EKS / KUBERNETES MAPPING\n\nIngress + AWS Load Balancer Controller → web Service → web Deployment\nscheduler Deployment: 1 active replica, lease still protects ownership\nKubernetes Job: migration image, run before rollout\nECR images → Deployments; HPA can scale stateless web only\nSecrets Manager CSI Driver / External Secrets → Kubernetes Secrets\nCloudWatch Container Insights or Prometheus + Grafana","fontSize":17,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":"k8s","originalText":"PROPOSED EKS / KUBERNETES MAPPING\n\nIngress + AWS Load Balancer Controller → web Service → web Deployment\nscheduler Deployment: 1 active replica, lease still protects ownership\nKubernetes Job: migration image, run before rollout\nECR images → Deployments; HPA can scale stateless web only\nSecrets Manager CSI Driver / External Secrets → Kubernetes Secrets\nCloudWatch Container Insights or Prometheus + Grafana","autoResize":true,"lineHeight":1.25},
    {"id":"note","type":"text","x":60,"y":945,"width":1540,"height":58,"angle":0,"strokeColor":"#334155","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"k0","roundness":null,"seed":100,"version":1,"versionNonce":100,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"Kubernetes design rule: keep CockroachDB Cloud external and authoritative. Treat web as horizontally scalable, scheduler as a singleton-style worker, and migrations as an ordered Job. Models run outside retryable database transactions; the engine commits only validated decisions.","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Kubernetes design rule: keep CockroachDB Cloud external and authoritative. Treat web as horizontally scalable, scheduler as a singleton-style worker, and migrations as an ordered Job. Models run outside retryable database transactions; the engine commits only validated decisions.","autoResize":true,"lineHeight":1.25},
