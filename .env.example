# Local 3-node cluster (infra/docker-compose.yml)
DATABASE_URL=postgresql://root@localhost:26257/hollowmere?sslmode=disable

# CockroachDB Cloud's downloaded CA certificate, base64-encoded for container
# secrets. Leave unset locally. Cloud DATABASE_URL values must use
# sslmode=verify-full; deployment strips laptop-only sslrootcert paths and uses
# this value instead.
DATABASE_CA_CERT_BASE64=

# AWS Bedrock. Until model access is granted, the engine runs on the
# deterministic stub and needs none of these. See docs/aws-setup.md.
AWS_REGION=us-east-1

# Azure is the only public world profile while the Bedrock model-access support
# case is pending. After access and `npm run check:bedrock` succeed, this is the
# only switch required to expose and accept the Bedrock option.
BEDROCK_ENABLED=false

# The "us." prefix is a cross-region inference profile, not a typo. Newer
# Anthropic models on Bedrock must be invoked through one; a bare
# "anthropic.claude-..." id returns ValidationException.
BEDROCK_REASONING_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Exact cross-region inference profile used by the Bedrock choice in new worlds.
# Do not substitute a different model while presenting it as Claude Sonnet 5.
BEDROCK_SONNET_REASONING_PROFILE=replace-with-enabled-sonnet-5-profile-id
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Must stay 1024 — the schema declares embedding VECTOR(1024) and the vector
# index is built on it. check-bedrock.ts asserts the two agree.
BEDROCK_EMBEDDING_DIM=1024
BEDROCK_MAX_ATTEMPTS=5
BEDROCK_CONNECT_TIMEOUT_MS=5000
BEDROCK_REQUEST_TIMEOUT_MS=30000

# Azure OpenAI. The model values are deployment names, not catalog model names.
# Keep the key in .env or Azure Key Vault; never commit it.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-resource-key
AZURE_OPENAI_REASONING_DEPLOYMENT=hollowmere-gpt-5-mini
# Azure deployment assigned to the always-enabled profile. Production currently
# uses GPT-5 mini because the subscription has no Terra quota; change only this
# value to hollowmere-gpt-5-6-terra after that deployment passes live preflight.
AZURE_OPENAI_TERRA_DEPLOYMENT=hollowmere-gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=hollowmere-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIM=1024

# 'stub' for deterministic tests and offline development. 'world' routes each
# private world to its immutable Azure Terra or Bedrock Sonnet selection.
# 'bedrock' and 'azure' remain available for single-provider scripts; 'replay'
# re-runs recorded cognition without provider calls.
INFERENCE_MODE=stub

# Structured server logs: debug, info, warn, error, or silent.
LOG_LEVEL=info

# Signs the anonymous browser session cookie used by the Phaser client.
# Use at least 32 random bytes in deployed environments.
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Public HTTPS origin used by same-origin checks behind a reverse proxy.
# Leave unset locally, where Next's request origin is already authoritative.
PUBLIC_ORIGIN=https://hollowmere.example.com

# Public health payload identity. Deployment sets BUILD_REVISION to the exact
# immutable image commit. Readiness returns 503 if its database check does not
# finish within the bounded timeout.
SERVICE_NAME=hollowmere-web
BUILD_REVISION=development
READINESS_TIMEOUT_MS=2000

# Maximum newly reserved player conversation turns per private world per minute.
CONVERSATION_RATE_LIMIT_PER_MINUTE=20

# The immutable scenario version created for a first-time browser session.
SCENARIO_VERSION=hollowmere-v2
